<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>waderLand</title>
</head>
<body>
    <h2>create new Listing  </h2>
</br>
    <form method="POST" action="/listings">
        <input name="listings[title]" placeholder="enter title" type="text">
    </br>
        <textarea name="listings[description]" placeholder="enter description"></textarea>
</br>
        <input name="listings[image]" placeholder="enter url" type="text">
        <br>
        <br>
        <input name="listings[price]" placeholder="enter price" type="number">
        <br>
        <input name="listings[location]" placeholder="enter location" type="text">
        <br>
        <input name="listings[country]" placeholder="enter country" type="text">
        <br>
        <button type="submit" >create</button>

    </form>
    
</body>
</html>