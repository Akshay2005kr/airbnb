<% layout("layouts/boilerplate") %>

<div class="row">
    <div class="col-8 offset-2">

        <h2>Edit Your Listing</h2>

        <form method="POST" action="/listings/<%= listing._id %>?_method=PUT"
     novalidate
     class="needs-validation">

            <!-- Title -->
            <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <input
                    name="listings[title]"
                    value="<%= listing.title %>"
                    placeholder="Enter title"
                    type="text"
                    class="form-control"
                    required
                    
                >
                 <div class="valid-feedback">Tital looks good</div>

            </div>

            <!-- Description -->
            <div class="mb-3">
                <label for="description" class="form-label">Description</label>
                <textarea
                    name="listings[description]"
                    class="form-control"
                    placeholder="Enter description"
                    required
                ><%= listing.description %></textarea>
                 <div class="invalid-feedback">Please enter Valide Dec</div>
            </div>

            <!-- Image URL -->
            <!-- Image URL -->
<div class="mb-3">
    <label for="image" class="form-label">Image URL</label>

    <input
        name="listings[image][url]"
        value="<%= listing.image.url %>"
        placeholder="Enter image URL"
        type="text"
        class="form-control"
    >

    <div class="invalid-feedback">
        Please enter a valid image URL.
    </div>
</div>

            <!-- Price -->
            <div class="mb-3">
                <label for="price" class="form-label">Price</label>
                <input
                    name="listings[price]"
                    value="<%= listing.price %>"
                    placeholder="Enter price"
                    
                    class="form-control"
                    required
                >
                 <div class="invalid-feedback">enter valide price</div>
            </div>

            <!-- Location and Country -->
            <div class="row">

                <!-- Location -->
                <div class="mb-3 col-md-8">
                    <label for="location" class="form-label">Location</label>
                    <input
                        name="listings[location]"
                        value="<%= listing.location %>"
                        placeholder="Enter location"
                        type="text"
                        class="form-control"
                        required
                    >
                     <div class="invalid-feedback">Please enter Valide location</div>
                </div>

                <!-- Country -->
                <div class="mb-3 col-md-4">
                    <label for="country" class="form-label">Country</label>
                    <input
                        name="listings[country]"
                        value="<%= listing.country %>"
                        placeholder="Enter country"
                        type="text"
                        class="form-control"
                        required
                    >
                     <div class="invalid-feedback">Please enter Valide country</div>
                </div>

            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn add-btn">
                Edit
            </button>

        </form>

    </div>
</div>
