<% layout("layouts/boilerplate") %>

<div class="container mt-5">

    <!-- Hero Section -->
    <div class="row align-items-center py-5">

        <div class="col-md-6">
            <h1 class="display-4 fw-bold">
                Welcome to WanderLust
            </h1>

            <p class="lead mt-3">
                Discover unique places to stay and explore amazing
                destinations around the world.
            </p>

            <div class="mt-4">
                <a href="/listings" class="btn btn-dark btn-lg">
                    Explore Listings
                </a>

                <a href="/listings/new" class="btn btn-outline-dark btn-lg ms-2">
                    Add Listing
                </a>
            </div>
        </div>

        <div class="col-md-6 text-center">
            <div class="p-5 bg-light rounded-4">
                <h2>🌍</h2>
                <h3>Find Your Next Adventure</h3>
                <p class="text-muted">
                    Stay somewhere unforgettable.
                </p>
            </div>
        </div>

    </div>

    <hr class="my-5">

    <!-- Features -->
    <div class="row text-center">

        <div class="col-md-4 mb-4">
            <div class="p-4">
                <h2>🏠</h2>
                <h4>Unique Homes</h4>
                <p class="text-muted">
                    Discover comfortable and unique places to stay.
                </p>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="p-4">
                <h2>🌎</h2>
                <h4>Explore Places</h4>
                <p class="text-muted">
                    Find beautiful destinations for your next trip.
                </p>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="p-4">
                <h2>⭐</h2>
                <h4>Great Experiences</h4>
                <p class="text-muted">
                    Create memorable experiences wherever you go.
                </p>
            </div>
        </div>

    </div>

</div>